# Copy to server/.env and fill in. server/.env is gitignored: never commit real values.
# The API server reads these; the phone and web apps never see them.
DB_HOST=192.168.1.5
DB_PORT=5432
DB_NAME=finance
DB_USER=finance_app
DB_PASSWORD=change-me
# require once the server has TLS set up; prefer works without it
DB_SSLMODE=prefer

# API server (npm start in server/)
API_HOST=0.0.0.0
API_PORT=8787
# first = only the first account can sign up (you); closed = nobody; open = anyone
SIGNUP=first
# Browser origins allowed to call the API, comma separated (the phone apps don't need this)
CORS_ORIGINS=http://localhost:8081
SESSION_DAYS=90
